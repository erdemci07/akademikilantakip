# Telegram: BotFather'dan alinir. Virgulle ayrilmis chat/user ID'leri yetkilidir.
TELEGRAM_BOT_TOKEN=
AUTHORIZED_TELEGRAM_IDS=

# OpenAI analizi istege baglidir. Anahtar yoksa ilan "human_review" durumunda kalir.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# local (gelistirme/test) veya firestore (zamanlanmis uretim taramasi)
DATABASE_BACKEND=local
SQLITE_PATH=data/ilanlar.db
FIREBASE_SERVICE_ACCOUNT_JSON=
FIRESTORE_COLLECTION_PREFIX=akademik_ilan_takip

# Kaynak kaydi (JSON dosya yolu)
SOURCES_FILE=config/sources.json
REQUEST_TIMEOUT_SECONDS=25
USER_AGENT=AkademikIlanTakip/0.1 (+https://github.com/your-org/akademik-ilan-takip)
